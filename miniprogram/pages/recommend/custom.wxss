.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.intro-title {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.intro-sub {
  font-size: 24rpx;
  line-height: 1.5;
}

.label {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.title-input {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  font-size: 28rpx;
}

.slots {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 12rpx;
}

.slot-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.slot-label {
  font-size: 28rpx;
  font-weight: 600;
}

.selected {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 24rpx;
}

.sel-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: var(--muted);
}

.sel-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sel-name {
  font-size: 28rpx;
}

.pick-scroll {
  width: 100%;
  white-space: nowrap;
}

.pick-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.empty-slot {
  padding: 24rpx 0;
  font-size: 24rpx;
}

.pick-card {
  width: 160rpx;
  display: inline-flex;
  flex-direction: column;
  gap: 8rpx;
}

.pick-img {
  width: 160rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--muted);
  display: block;
}

.pick-name {
  font-size: 22rpx;
  color: var(--fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview {
  margin-top: 8rpx;
}

.preview-row {
  display: flex;
  gap: 12rpx;
}

.preview-cell {
  flex: 1;
  min-width: 0;
  position: relative;
}

.preview-img {
  width: 100%;
  height: 200rpx;
  border-radius: 20rpx;
  display: block;
  background: var(--muted);
}

.preview-slot {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg) 70%, rgba(250, 247, 244, 0));
}

.save {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 24rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}
