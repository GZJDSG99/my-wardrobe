.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(28, 25, 23, 0.08);
  backdrop-filter: blur(20px);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-top: 12rpx;
}

.icon-wrap {
  width: 80rpx;
  height: 48rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-on {
  background: rgba(181, 105, 90, 0.15);
}

.icon {
  font-size: 28rpx;
  color: #8c7b75;
  line-height: 1;
}

.on .icon {
  color: #b5695a;
}

.label {
  font-size: 20rpx;
  color: #8c7b75;
  font-weight: 500;
}

.on .label {
  color: #b5695a;
}
