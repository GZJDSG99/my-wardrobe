.header {
  padding-top: 24rpx;
  padding-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.brand {
  font-size: 56rpx;
  line-height: 1.15;
  letter-spacing: 0.02em;
  color: var(--fg);
}

.brand-en {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.04em;
  color: var(--primary);
}

.brand-zh {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.page-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg);
}

.header-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 8rpx;
}

.meta-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
}

.streak {
  color: var(--primary);
  font-weight: 500;
}

.dot {
  color: var(--muted-fg);
}

.weather-strip {
  margin: 8rpx 40rpx 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: var(--primary-soft);
  border: 1rpx solid rgba(181, 105, 90, 0.2);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.weather-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sun,
.weather-main {
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 500;
}

.weather-hint {
  flex: 1;
  text-align: right;
  font-size: 22rpx;
  color: rgba(181, 105, 90, 0.7);
}

.chev {
  color: rgba(181, 105, 90, 0.55);
  font-size: 32rpx;
}

.theme-scroll {
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.theme-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 8rpx;
}

.theme-chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--muted-fg);
  font-size: 24rpx;
}

.theme-on {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.outfit-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 16rpx;
}

.outfit {
  overflow: hidden;
  border-radius: 48rpx;
}

.cover-wrap {
  position: relative;
  height: 360rpx;
  background: var(--muted);
}

.piece-grid {
  display: flex;
  width: 100%;
  height: 100%;
}

.piece-cell {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100%;
  border-right: 2rpx solid rgba(255, 255, 255, 0.35);
}

.piece-cell:last-child {
  border-right: none;
}

.piece-img {
  width: 100%;
  height: 100%;
  display: block;
}

.piece-fallback {
  opacity: 0.9;
}

.piece-meta {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 12rpx;
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
  z-index: 2;
}

.piece-slot,
.piece-flag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
}

.cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 50%);
  pointer-events: none;
}

.tag-row {
  position: absolute;
  top: auto;
  bottom: 100rpx;
  left: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  z-index: 2;
}

.img-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 20rpx;
}

.cover-foot {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  z-index: 2;
}

.sub {
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  margin-bottom: 4rpx;
}

.title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.like {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.stamp {
  position: absolute;
  right: 28rpx;
  top: 40%;
  padding: 10rpx 18rpx;
  border: 4rpx solid #fff;
  color: #fff;
  font-size: 28rpx;
  transform: rotate(-12deg);
  background: rgba(181, 105, 90, 0.55);
  z-index: 3;
}

.body {
  padding: 28rpx;
}

.reason {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--fg);
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  background: var(--secondary);
  border-radius: 20rpx;
}

.label-muted {
  font-size: 20rpx;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted-fg);
  font-weight: 500;
  margin-bottom: 14rpx;
}

.piece-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.piece-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.piece-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--muted);
}

.piece-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.piece-name {
  font-size: 26rpx;
  color: var(--fg);
}

.piece-slot-sm {
  font-size: 20rpx;
}

.item-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.body-foot {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.wear-btn {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.empty-rec {
  margin-top: 24rpx;
  padding: 64rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
}

.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-btn.ghost {
  background: transparent;
  color: var(--primary);
  border: 1rpx solid rgba(181, 105, 90, 0.45);
}

.custom-bar {
  margin-top: 4rpx;
  margin-bottom: 4rpx;
}

.custom-btn {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid rgba(181, 105, 90, 0.25);
}
