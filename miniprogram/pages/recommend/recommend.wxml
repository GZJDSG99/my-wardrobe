<view class="page">
  <view class="header section-pad">
    <view class="header-main">
      <view class="brand font-display">Dresia</view>
      <view class="brand-en">Open Your Closet. Discover Your Style.</view>
      <view class="brand-zh muted">打开衣橱，发现更多风格</view>
      <view class="page-title">今日穿搭</view>
      <view class="meta-row">
        <text class="streak">连续出门 {{streak}} 天</text>
        <text class="dot">·</text>
        <text class="muted" bindtap="onGoWardrobe">衣橱 {{realRatio}} 件</text>
      </view>
    </view>
    <view class="header-actions">
      <view class="icon-btn">🔔</view>
      <view class="icon-btn">⌕</view>
    </view>
  </view>

  <view class="weather-strip section-pad" bindtap="onGoWeather">
    <view class="weather-left">
      <text class="sun">☀</text>
      <text class="weather-main">{{weatherTip}}</text>
    </view>
    <text class="weather-hint">{{weatherHint}}</text>
    <text class="chev">›</text>
  </view>

  <scroll-view scroll-x class="theme-scroll section-pad" enhanced show-scrollbar="{{false}}">
    <view class="theme-row">
      <view
        wx:for="{{themes}}"
        wx:key="id"
        class="theme-chip {{item.on ? 'theme-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickTheme"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{loggedIn}}" class="custom-bar section-pad">
    <button class="custom-btn" bindtap="onCustom">＋ 自定义搭配</button>
  </view>

  <view wx:if="{{loadingRec}}" class="muted section-pad" style="padding-top: 8rpx;">正在根据天气与衣橱生成推荐…</view>

  <view wx:elif="{{empty}}" class="empty-rec section-pad">
    <view class="empty-title font-display">{{emptyTip}}</view>
    <view class="empty-sub muted">{{emptySub}}</view>
    <button wx:if="{{!loggedIn}}" class="empty-btn" bindtap="onGoLogin">去登录</button>
    <view wx:else class="empty-actions">
      <button class="empty-btn" bindtap="onGoWardrobe">去衣橱添加</button>
      <button class="empty-btn ghost" bindtap="onCustom">自定义搭配</button>
    </view>
  </view>

  <view wx:else class="outfit-list section-pad">
    <view wx:for="{{outfits}}" wx:key="id" class="outfit card">
      <view class="cover-wrap">
        <view class="piece-grid">
          <view
            wx:for="{{item.pieces}}"
            wx:for-item="piece"
            wx:key="id"
            class="piece-cell"
          >
            <image
              wx:if="{{piece.image}}"
              class="piece-img"
              src="{{piece.image}}"
              mode="aspectFill"
              lazy-load
            />
            <view
              wx:else
              class="piece-img piece-fallback"
              style="background: {{piece.color}};"
            ></view>
            <view class="piece-meta">
              <text class="piece-slot">{{piece.slot}}</text>
            </view>
          </view>
        </view>
        <view class="cover-mask"></view>
        <view class="tag-row">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="img-tag">{{tag}}</text>
          <text class="img-tag">{{item.realCount}} 件</text>
        </view>
        <view class="cover-foot">
          <view>
            <view class="sub">{{item.subtitle}}</view>
            <view class="title font-display">{{item.title}}</view>
          </view>
          <view
            class="like"
            data-id="{{item.id}}"
            catchtap="onToggleLike"
          >{{item.likeIcon}}</view>
        </view>
        <view wx:if="{{stamped}}" class="stamp font-display">今天穿这套</view>
      </view>

      <view class="body">
        <view class="reason">{{item.reason}}</view>
        <view class="label-muted">搭配单品</view>
        <view class="piece-list">
          <view wx:for="{{item.pieces}}" wx:for-item="piece" wx:key="id" class="piece-row">
            <image
              wx:if="{{piece.image}}"
              class="piece-thumb"
              src="{{piece.image}}"
              mode="aspectFill"
            />
            <view
              wx:else
              class="piece-thumb"
              style="background: {{piece.color}};"
            ></view>
            <view class="piece-info">
              <text class="piece-name">{{piece.name}}</text>
              <text class="muted piece-slot-sm">{{piece.slot}}</text>
            </view>
          </view>
        </view>
        <view class="body-foot">
          <text class="muted">{{item.temp}} 适用</text>
          <button
            class="wear-btn"
            data-id="{{item.id}}"
            bindtap="onWear"
          >{{item.wearLabel}}</button>
        </view>
      </view>
    </view>
  </view>
</view>
