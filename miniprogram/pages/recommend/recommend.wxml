<view class="page">
  <view class="header section-pad">
    <view class="header-main">
      <view class="eyebrow">{{dateLabel}}</view>
      <view class="h1">今日穿搭</view>
      <view class="meta-row">
        <text class="streak">连续出门 {{streak}} 天</text>
        <text class="dot">·</text>
        <text class="muted" bindtap="onGoWardrobe">真实单品 {{realRatio}}</text>
      </view>
    </view>
    <view class="header-actions">
      <view class="icon-btn">🔔</view>
      <view class="icon-btn">⌕</view>
    </view>
  </view>

  <view class="weather-strip section-pad" bindtap="onGoWeather">
    <view class="weather-left">
      <text class="sun">☀</text>
      <text class="weather-main">{{weatherTip}}</text>
    </view>
    <text class="weather-hint">{{weatherHint}}</text>
    <text class="chev">›</text>
  </view>

  <scroll-view scroll-x class="theme-scroll section-pad" enhanced show-scrollbar="{{false}}">
    <view class="theme-row">
      <view
        wx:for="{{themes}}"
        wx:key="id"
        class="theme-chip {{item.on ? 'theme-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickTheme"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view class="outfit-list section-pad">
    <view wx:for="{{outfits}}" wx:key="id" class="outfit card">
      <view class="cover-wrap">
        <image class="cover" src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="cover-mask"></view>
        <view class="tag-row">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="img-tag">{{tag}}</text>
        </view>
        <view class="cover-foot">
          <view>
            <view class="sub">{{item.subtitle}}</view>
            <view class="title font-display">{{item.title}}</view>
          </view>
          <view
            class="like"
            data-id="{{item.id}}"
            catchtap="onToggleLike"
          >{{item.liked ? '♥' : '♡'}}</view>
        </view>
        <view wx:if="{{stampedId === item.id}}" class="stamp font-display">今天穿这套</view>
      </view>

      <view class="body">
        <view class="reason">{{item.reason}}</view>
        <view class="label-muted">搭配单品</view>
        <view class="item-pills">
          <text wx:for="{{item.items}}" wx:for-item="piece" wx:key="*this" class="pill">{{piece}}</text>
        </view>
        <view class="body-foot">
          <text class="muted">{{item.temp}} 适用</text>
          <button
            class="wear-btn"
            data-id="{{item.id}}"
            bindtap="onWear"
          >{{stampedId === item.id ? '已采纳' : '今天穿这套'}}</button>
        </view>
      </view>
    </view>
  </view>

  <view class="styles section-pad">
    <view class="styles-head">
      <text class="h3 font-display">风格灵感</text>
      <text class="primary more">查看更多</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="style-row">
        <view wx:for="{{styles}}" wx:key="label" class="style-card">
          <image class="style-img" src="{{item.img}}" mode="aspectFill" lazy-load />
          <text class="style-label">{{item.label}}风</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
