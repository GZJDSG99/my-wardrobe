.hero {
  padding: 32rpx 40rpx 24rpx;
  background: linear-gradient(to bottom, var(--secondary), var(--bg));
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(181, 105, 90, 0.3);
  background: var(--muted);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 48rpx;
  background: var(--secondary);
}

.streak-line {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.login-state {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.login-bar {
  margin-top: 28rpx;
}

.login-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info {
  flex: 1;
}

.name {
  font-size: 40rpx;
  font-weight: 600;
}

.styles {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.stats {
  margin-top: 36rpx;
  display: flex;
  border-radius: 32rpx;
  overflow: hidden;
}

.stat {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-right: 1rpx solid var(--border);
}

.stat:last-child {
  border-right: none;
}

.stat-val {
  font-size: 44rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.block-title {
  font-size: 26rpx;
  font-weight: 600;
  margin: 8rpx 0 20rpx;
}

.health {
  padding: 28rpx;
  border-radius: 32rpx;
}

.health-top {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 14rpx;
}

.score {
  font-weight: 600;
}

.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--muted);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(to right, var(--primary), var(--accent));
}

.health-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.menu-wrap {
  margin-top: 28rpx;
  margin-bottom: 24rpx;
}

.menu {
  overflow: hidden;
  border-radius: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--secondary);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
}

.menu-label {
  font-size: 28rpx;
  font-weight: 500;
}

.menu-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.chev {
  font-size: 36rpx;
}
