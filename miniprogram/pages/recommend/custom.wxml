<view class="page">
  <view class="section-pad intro">
    <view class="intro-title font-display">组一套自己的</view>
    <view class="muted intro-sub">从上装、下装开始选，鞋履与外套可选。</view>
  </view>

  <view class="section-pad">
    <view class="label">搭配名称</view>
    <input
      class="title-input"
      placeholder="例如：周一通勤"
      maxlength="16"
      value="{{title}}"
      bindinput="onTitle"
    />
  </view>

  <view class="slots section-pad">
    <view wx:for="{{slots}}" wx:key="key" class="slot-block">
      <view class="slot-head">
        <text class="slot-label">{{item.label}}</text>
        <text class="muted">{{item.required ? '必选' : '可选'}}</text>
      </view>

      <view wx:if="{{item.selected}}" class="selected card" data-key="{{item.key}}" bindtap="onClearSlot">
        <image
          wx:if="{{item.selected.image}}"
          class="sel-img"
          src="{{item.selected.image}}"
          mode="aspectFill"
        />
        <view wx:else class="sel-img" style="background: {{item.selected.color}};"></view>
        <view class="sel-info">
          <text class="sel-name">{{item.selected.name}}</text>
          <text class="muted">点击取消</text>
        </view>
      </view>

      <scroll-view wx:else scroll-x class="pick-scroll" enhanced show-scrollbar="{{false}}">
        <view class="pick-row">
          <view wx:if="{{item.options.length === 0}}" class="muted empty-slot">衣橱暂无此类</view>
          <view
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="id"
            class="pick-card"
            data-key="{{item.key}}"
            data-id="{{opt.id}}"
            bindtap="onPick"
          >
            <image wx:if="{{opt.image}}" class="pick-img" src="{{opt.image}}" mode="aspectFill" />
            <view wx:else class="pick-img" style="background: {{opt.color}};"></view>
            <text class="pick-name">{{opt.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="preview section-pad" wx:if="{{previewPieces.length}}">
    <view class="label">预览</view>
    <view class="preview-row">
      <view wx:for="{{previewPieces}}" wx:key="id" class="preview-cell">
        <image wx:if="{{item.image}}" class="preview-img" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="preview-img" style="background: {{item.color}};"></view>
        <text class="preview-slot">{{item.slot}}</text>
      </view>
    </view>
  </view>

  <view class="footer section-pad">
    <button class="save" loading="{{saving}}" bindtap="onSave">保存搭配</button>
  </view>
</view>
