<view class="page page-sub">
  <view class="hero-card card">
    <view class="font-display title">先把每天穿得舒服</view>
    <view class="muted sub">会员后置。免费保证每日推荐可用，付费买更深能力。</view>
  </view>

  <view wx:for="{{plans}}" wx:key="name" class="plan card">
    <view class="plan-top">
      <text class="plan-name font-display">{{item.name}}</text>
      <text class="primary">{{item.price}}</text>
    </view>
    <view wx:for="{{item.features}}" wx:for-item="f" wx:key="*this" class="feat muted">· {{f}}</view>
  </view>

  <view class="section-pad">
    <button class="primary-btn block" bindtap="onNotify">开通提醒我</button>
  </view>
</view>
