<view class="page page-sub {{pageEnter ? 'page-enter' : ''}}">
  <view class="profile-edit card">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-ph">选头像</view>
    </button>
    <input
      class="nick"
      type="nickname"
      maxlength="20"
      placeholder="填写昵称"
      value="{{nickName}}"
      bindinput="onNickInput"
      bindblur="onNickInput"
      bindchange="onNickInput"
    />
  </view>

  <view class="section-pad">
    <view class="block-title">风格标签（最多 4 个）</view>
    <view class="chips">
      <view
        wx:for="{{styleOptions}}"
        wx:key="id"
        class="chip {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onToggleStyle"
      >{{item.id}}</view>
    </view>
  </view>

  <view class="section-pad">
    <view class="block-title">常去场景</view>
    <view class="chips">
      <view
        wx:for="{{sceneOptions}}"
        wx:key="id"
        class="chip {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onToggleScene"
      >{{item.id}}</view>
    </view>
  </view>

  <view class="section-pad footer">
    <button class="primary-btn block" loading="{{saving}}" bindtap="onSave">保存偏好</button>
  </view>
</view>
