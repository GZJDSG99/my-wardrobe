.page-home {
  height: 100vh;
  box-sizing: border-box;
  background: #f9f2e9;
}

.home-scroll {
  height: 100%;
  box-sizing: border-box;
}

.home-inner {
  padding-top: 12rpx;
  padding-bottom: 0;
}

.home-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.date-label {
  font-family: "DM Sans", "PingFang SC", sans-serif;
  font-size: 18rpx;
  letter-spacing: 0.22em;
  color: #c8b8a4;
  text-transform: uppercase;
}

.home-title {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 400;
  color: #2e2821;
  line-height: 1.2;
}

.greet {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 300;
}

.home-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.idle-pill,
.weather-pill {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(155, 132, 112, 0.18);
  background: rgba(250, 245, 238, 0.7);
}

.idle-pill {
  flex-direction: column;
  gap: 2rpx;
  padding: 10rpx 16rpx 8rpx;
  border-radius: 24rpx;
  border-color: transparent;
  background: transparent;
  animation: idleBreathe 4.5s ease-in-out infinite;
}

@keyframes idleBreathe {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
}

.idle-hanger {
  position: relative;
  width: 44rpx;
  height: 36rpx;
}

.idle-hanger-hook {
  position: absolute;
  left: 22rpx;
  top: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #c4a882;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
  box-sizing: border-box;
}

.idle-hanger-body {
  position: absolute;
  left: 4rpx;
  top: 14rpx;
  width: 36rpx;
  height: 18rpx;
  border-left: 3rpx solid #c4a882;
  border-right: 3rpx solid #c4a882;
  border-top: 3rpx solid #c4a882;
  border-radius: 2rpx 2rpx 0 0;
  transform: perspective(40rpx) rotateX(12deg);
  box-sizing: border-box;
}

.idle-hanger-bar {
  position: absolute;
  left: 2rpx;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  border: 3rpx solid #c4a882;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.idle-ico,
.weather-ico {
  font-size: 20rpx;
  color: #c4a882;
}

.idle-txt,
.weather-txt {
  font-size: 20rpx;
  color: #8a7060;
  max-width: 160rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.idle-pill .idle-txt {
  font-size: 16rpx;
  color: #c4a882;
  letter-spacing: 0.05em;
  max-width: none;
}

.idle-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #e8a0a8;
  color: #fff;
  font-size: 16rpx;
  line-height: 28rpx;
  text-align: center;
  border: 2rpx solid #fff;
  animation: idleGlow 2.2s ease-in-out infinite;
}

@keyframes idleGlow {
  0%,
  100% {
    box-shadow: 0 0 0 rgba(232, 160, 168, 0);
  }
  50% {
    box-shadow: 0 0 12rpx rgba(232, 160, 168, 0.55);
  }
}

.sec {
  margin-bottom: 28rpx;
}

.sec-label {
  font-family: "DM Sans", "PingFang SC", sans-serif;
  font-size: 18rpx;
  letter-spacing: 0.22em;
  color: #c4b5a0;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.sec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sec-actions {
  display: flex;
  gap: 24rpx;
}

.link {
  font-size: 22rpx;
  color: #9b8470;
}

.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
  margin-top: 4rpx;
}

.mood-chip,
.plain-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(155, 132, 112, 0.18);
  background: #f5f0ea;
  color: #7a6a58;
  font-size: 22rpx;
  font-weight: 300;
}

.mood-chip.on,
.plain-chip.on {
  background: #e2ceba;
  border-color: #c4a882;
  color: #3a2e22;
  box-shadow: 0 6rpx 20rpx rgba(196, 168, 130, 0.22);
  transform: translateY(-2rpx);
}

.mood-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.lucky-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  padding: 32rpx 24rpx;
  border-radius: 40rpx;
  background: linear-gradient(150deg, #4a3a2c 0%, #3e3026 55%, #50402e 100%);
  box-shadow: 0 10rpx 40rpx rgba(74, 58, 44, 0.28);
  box-sizing: border-box;
}

.lucky-ico {
  color: #e8d8c4;
  font-size: 28rpx;
}

.lucky-txt {
  color: #faf6f0;
  font-size: 32rpx;
  letter-spacing: 0.05em;
  font-weight: 300;
}

.lucky-hint {
  text-align: center;
  font-size: 20rpx;
  margin-top: 14rpx;
  margin-bottom: 32rpx;
  letter-spacing: 0.04em;
}

.lucky-block {
  margin-bottom: 24rpx;
}

.state {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
}

.empty-box {
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  margin: 0;
}

.empty-btn.ghost {
  background: #fff;
  color: var(--fg);
  border: 1rpx solid var(--border);
}

.hero-card {
  margin-bottom: 28rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid rgba(155, 132, 112, 0.15);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.hero-card.hero-perfect {
  border-color: rgba(196, 168, 130, 0.35);
  box-shadow: 0 12rpx 48rpx rgba(196, 168, 130, 0.2),
    0 4rpx 16rpx rgba(196, 168, 130, 0.1);
}

.hero-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid rgba(196, 168, 130, 0.18);
  background: linear-gradient(90deg, #faf5ee 0%, #f5eddf 100%);
}

.hero-banner-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.hero-leaf {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c4a882, #b89060);
  color: #fff;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 32rpx;
}

.hero-banner-title {
  font-size: 22rpx;
  color: #7a5e3a;
}

.hero-banner-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.hero-mini-tag {
  font-size: 18rpx;
  color: #9b7848;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(196, 168, 130, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.hero-media {
  position: relative;
  height: 360rpx;
  background: #ede5d8;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 28rpx 32rpx;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.48),
    rgba(0, 0, 0, 0.08),
    transparent
  );
}

.hero-mood-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 20rpx;
}

.hero-phrase {
  color: #fff;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 400;
}

.hero-body {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-items {
  font-size: 26rpx;
  color: #3a3028;
  line-height: 1.4;
}

.hero-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.45;
}

.scene-tip {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(196, 168, 130, 0.18);
  background: rgba(250, 245, 238, 0.7);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.scene-tip-emoji {
  font-size: 28rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.scene-tip-title {
  font-size: 22rpx;
  color: #6a5038;
}

.scene-tip-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.45;
}

.hero-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  width: 140rpx;
}

.hero-wear {
  width: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.outfit-scroll {
  width: 100%;
  white-space: nowrap;
}

.outfit-row {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.outfit-card {
  width: 336rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid rgba(155, 132, 112, 0.14);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  white-space: normal;
}

.outfit-media {
  position: relative;
  height: 256rpx;
  background: #ede5d8;
}

.outfit-img {
  width: 100%;
  height: 100%;
  display: block;
}

.outfit-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent);
}

.outfit-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 18rpx;
  margin-bottom: 8rpx;
}

.outfit-title {
  color: #fff;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 400;
}

.outfit-body {
  padding: 20rpx;
}

.outfit-items {
  font-size: 24rpx;
  color: #3a3028;
  line-height: 1.35;
}

.outfit-tip {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.outfit-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.like-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f5f0ea;
  color: #b5695a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.wear-btn {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #2e2821;
  color: #faf8f4;
  font-size: 22rpx;
}

.petal-div,
.diary-div {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 36rpx;
}

.petal-div .line,
.diary-div .line {
  flex: 1;
  height: 1rpx;
  background: rgba(155, 132, 112, 0.12);
}

.petal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50% 50% 48% 48%;
  background: #c4b5a0;
  opacity: 0.35;
}

.diary-label {
  font-family: "DM Sans", sans-serif;
  font-size: 18rpx;
  letter-spacing: 0.25em;
  color: #d4c4b0;
}

.cal-wrap {
  position: relative;
  margin-bottom: 40rpx;
  overflow: visible;
}

.cal-burst-petal {
  position: absolute;
  z-index: 50;
  pointer-events: none;
  border-radius: 50% 50% 45% 45%;
  transform-origin: center bottom;
  opacity: 0.88;
  animation-name: calPetalFloat;
  animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
  animation-fill-mode: both;
  margin-left: -6px;
  margin-top: -6px;
}

@keyframes calPetalFloat {
  0% {
    opacity: 0.88;
    transform: translateY(0) translateX(0) rotate(var(--pr, 0deg)) scale(1);
  }
  60% {
    opacity: 0.55;
  }
  100% {
    opacity: 0;
    transform: translateY(-58px) translateX(var(--dx, 0px))
      rotate(calc(var(--pr, 0deg) + 210deg)) scale(0.22);
  }
}

.cal-card {
  padding: 32rpx 24rpx 0;
  border-radius: 36rpx;
  overflow: hidden;
  border: 1rpx solid rgba(195, 168, 130, 0.12);
  background: linear-gradient(
    160deg,
    rgba(252, 249, 244, 0.92) 0%,
    rgba(245, 239, 230, 0.88) 100%
  );
  box-shadow:
    0 8rpx 48rpx rgba(180, 152, 110, 0.12),
    0 2rpx 12rpx rgba(180, 152, 110, 0.07),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.cal-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.cal-title {
  font-size: 36rpx;
  color: #2e2821;
  font-weight: 300;
  line-height: 1.2;
}

.cal-stat {
  text-align: right;
}

.cal-count {
  font-family: "DM Sans", sans-serif;
  font-size: 40rpx;
  color: #9b8470;
  font-weight: 300;
  line-height: 1.1;
  margin-top: 4rpx;
}

.cal-unit {
  font-size: 20rpx;
  color: #b5a090;
  margin-left: 4rpx;
}

.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 12rpx;
}

.cal-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(155, 132, 112, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9b8470;
  font-size: 32rpx;
  line-height: 1;
}

.cal-month {
  font-size: 26rpx;
  color: #2e2821;
  font-weight: 300;
}

.cal-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 0 4rpx;
  margin-bottom: 4rpx;
}

.cal-wd {
  text-align: center;
  font-size: 20rpx;
  color: #c8b8a4;
  font-family: "DM Sans", sans-serif;
  padding: 8rpx 0;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 0 4rpx 24rpx;
}

.cal-slot {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0 2rpx;
  min-height: 96rpx;
}

.cal-slot.empty {
  pointer-events: none;
  min-height: 0;
}

.cal-day {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  background: transparent;
  transition: transform 0.2s ease;
}

.cal-day.today {
  border-color: #c4a882;
  background: rgba(196, 168, 130, 0.12);
}

.cal-day.sel {
  border-color: #c4a882;
  transform: scale(1.1);
  box-shadow: 0 4rpx 16rpx rgba(180, 152, 110, 0.22);
}

.cal-day-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.cal-today-glow {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(
    circle at center,
    rgba(196, 168, 130, 0.22) 0%,
    transparent 70%
  );
  pointer-events: none;
}

.cal-day-num {
  font-size: 22rpx;
  color: #5a4a3a;
  font-family: "DM Sans", sans-serif;
  position: relative;
  z-index: 2;
}

.cal-day-num.on-thumb {
  color: #fff;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.45);
  font-weight: 500;
}

.cal-day-num.today-num {
  color: #9b8470;
  font-weight: 500;
}

.cal-day-num.today-num.on-thumb {
  color: #fff;
}

.cal-petal {
  position: absolute;
  top: 0;
  right: 8rpx;
  width: 16rpx;
  height: 20rpx;
  border-radius: 50% 50% 45% 45%;
  transform: translate(20%, -10%) rotate(-8deg);
  opacity: 0.85;
  pointer-events: none;
  z-index: 2;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.cal-ev-dots {
  display: flex;
  gap: 4rpx;
  justify-content: center;
  margin-top: 4rpx;
  min-height: 10rpx;
}

.cal-ev-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.cal-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  padding: 20rpx 16rpx 28rpx;
  border-top: 1rpx solid rgba(155, 132, 112, 0.1);
}

.cal-legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cal-legend-label {
  font-size: 20rpx;
  color: #b5a090;
  font-weight: 300;
}

.cal-panel {
  margin-top: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid rgba(155, 132, 112, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(180, 152, 110, 0.08);
  animation: calPanelIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes calPanelIn {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cal-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid rgba(155, 132, 112, 0.1);
}

.cal-panel-date {
  font-size: 24rpx;
  color: #6a5a4a;
}

.cal-add-btn {
  font-size: 22rpx;
  color: #9b8470;
  background: #f5efe7;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 300;
}

.cal-panel-log {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}

.cal-panel-img {
  width: 112rpx;
  height: 144rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #ede5d8;
}

.cal-panel-img.placeholder {
  background: linear-gradient(145deg, #f0e8dc, #e4d8c8);
}

.cal-panel-body {
  flex: 1;
  padding-top: 4rpx;
  min-width: 0;
}

.cal-panel-desc {
  font-size: 24rpx;
  color: #2e2821;
  line-height: 1.45;
}

.cal-panel-mood {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #9b8470;
  background: #f0e8dc;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 300;
}

.cal-panel-events {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 28rpx 24rpx;
}

.cal-chip {
  font-size: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 300;
}

.cal-panel-empty {
  padding: 40rpx 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b5a090;
  font-weight: 300;
}

.event-sheet {
  width: 100%;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUpSheet 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes slideUpSheet {
  from {
    transform: translateY(40rpx);
    opacity: 0.85;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.event-sheet-title {
  font-size: 30rpx;
  color: #2e2821;
  font-weight: 400;
  margin-bottom: 4rpx;
}

.event-sheet-date {
  font-size: 22rpx;
  margin-bottom: 28rpx;
}

.event-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.event-opt {
  padding: 28rpx 12rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.event-opt-emoji {
  font-size: 36rpx;
  line-height: 1.2;
  min-height: 48rpx;
  display: flex;
  align-items: center;
}

.event-opt-label {
  font-size: 22rpx;
}

.event-cancel {
  width: 100%;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 20rpx;
  border: 1rpx solid rgba(155, 132, 112, 0.25);
  font-size: 24rpx;
  color: #9b8b7a;
  font-weight: 300;
  box-sizing: border-box;
}

.freq-sec {
  margin-bottom: 24rpx;
}

.freq-empty {
  font-size: 22rpx;
  padding: 16rpx 0 32rpx;
}

.freq-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(155, 132, 112, 0.1);
}

.freq-row:last-child {
  border-bottom: none;
}

.freq-name {
  flex: 1;
  font-size: 26rpx;
  color: #2e2821;
  font-weight: 300;
}

.freq-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.freq-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.freq-tag.tag-hot {
  background: #e0ede0;
  color: #4a6b4a;
}

.freq-tag.tag-idle {
  background: #f5e8e0;
  color: #b5604a;
}

.freq-count {
  width: 72rpx;
  text-align: right;
  font-size: 24rpx;
  font-family: "DM Sans", sans-serif;
}

.home-bottom-space {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(28, 25, 23, 0.45);
  display: flex;
  align-items: flex-end;
}

.detail-sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(155, 132, 112, 0.25);
  margin: 0 auto 28rpx;
}

.detail-title {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.detail-reason {
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.detail-items {
  font-size: 26rpx;
  color: #3a3028;
  margin-bottom: 32rpx;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
}

.detail-like,
.detail-wear {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
}

.detail-like {
  background: #fff;
  color: var(--fg);
  border: 1rpx solid var(--border);
}

.detail-wear {
  background: var(--primary);
  color: #fff;
}

/* Idle browser */
.idle-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 11000;
  display: flex;
  flex-direction: column;
  animation: idleFadeIn 0.22s ease both;
}

@keyframes idleFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.idle-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 22, 16, 0.88);
}

.idle-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(24rpx + env(safe-area-inset-top)) 40rpx 8rpx;
}

.idle-kicker {
  font-family: "DM Sans", sans-serif;
  font-size: 18rpx;
  letter-spacing: 0.28em;
  color: #c4a882;
  text-transform: uppercase;
}

.idle-title {
  margin-top: 4rpx;
  font-size: 40rpx;
  color: #faf0e6;
  font-weight: 300;
}

.idle-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e8d8c8;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.idle-counter {
  position: relative;
  z-index: 2;
  text-align: center;
  font-family: "DM Sans", sans-serif;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: #c4a882;
  padding: 8rpx 0 16rpx;
}

.idle-stage {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  min-height: 0;
}

.idle-stack {
  position: relative;
  width: 100%;
  height: 680rpx;
}

.idle-card {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  transform-origin: center bottom;
  transition: all 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.idle-card.front {
  pointer-events: auto;
}

.idle-card-inner {
  height: 100%;
  border-radius: 36rpx;
  overflow: hidden;
  background: linear-gradient(175deg, #fcf8f3 0%, #f6eddf 100%);
  border: 1rpx solid rgba(196, 168, 130, 0.18);
}

.idle-card.front .idle-card-inner {
  border-color: rgba(196, 168, 130, 0.4);
  box-shadow: 0 56rpx 128rpx rgba(16, 10, 4, 0.55),
    0 12rpx 36rpx rgba(196, 168, 130, 0.1);
}

.idle-card-inner.float {
  animation: idleFloatCard 7s ease-in-out infinite;
}

@keyframes idleFloatCard {
  0%,
  100% {
    transform: translateY(0);
  }
  38% {
    transform: translateY(-18rpx);
  }
  68% {
    transform: translateY(-8rpx);
  }
}

.idle-card-media {
  position: relative;
  height: 440rpx;
}

.idle-card-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #ede5d8;
}

.idle-card-img.placeholder {
  background: linear-gradient(145deg, #efe4d4, #e0d2c0);
}

.idle-card-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.55) 0%,
    rgba(0, 0, 0, 0.1) 45%,
    transparent 100%
  );
}

.idle-super {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 18rpx;
  color: #b56070;
}

.idle-wear-pill {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(232, 160, 168, 0.9);
  font-size: 18rpx;
  color: #fff;
}

.idle-card-name {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  font-size: 38rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1.25;
}

.idle-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 32rpx;
}

.idle-card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.idle-cat {
  font-size: 20rpx;
  color: #b5a090;
  background: #f0e8dc;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.idle-color {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: #b5a090;
}

.idle-swatch {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(155, 132, 112, 0.3);
  flex-shrink: 0;
}

.idle-swatch.sm {
  width: 16rpx;
  height: 16rpx;
}

.idle-match-btn {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2e2821, #4a3828);
  color: #f5ede0;
  font-size: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 40, 33, 0.38);
}

.idle-nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
}

.idle-nav-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e8d8c8;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.idle-nav-btn.light {
  width: 72rpx;
  height: 72rpx;
  color: #9b8470;
  background: rgba(255, 255, 255, 0.7);
  border-color: rgba(196, 168, 130, 0.25);
  font-size: 32rpx;
}

.idle-nav-btn.disabled {
  opacity: 0.3;
  pointer-events: none;
}

.idle-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.idle-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  transition: all 0.3s ease;
}

.idle-dot.on {
  width: 44rpx;
  background: #c4a882;
}

.idle-match-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  max-height: 72vh;
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(175deg, #fbf5ee 0%, #f5ecdf 100%);
  animation: slideUpSheet 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
  display: flex;
  flex-direction: column;
}

.idle-match-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx 8rpx;
}

.idle-match-back {
  font-size: 24rpx;
  color: #9b8470;
  width: 120rpx;
}

.idle-match-spacer {
  width: 120rpx;
}

.idle-match-body {
  max-height: calc(72vh - 100rpx);
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.idle-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 28rpx;
}

.idle-loading-ring {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(196, 168, 130, 0.2);
  border-top-color: #c4a882;
  animation: idleSpin 0.9s linear infinite;
}

@keyframes idleSpin {
  to {
    transform: rotate(360deg);
  }
}

.idle-loading-txt {
  font-size: 24rpx;
  color: #b5a090;
  text-align: center;
}

.idle-loading-txt.empty {
  padding: 64rpx 0;
}

.idle-match-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: #b5a090;
}

.idle-outfit-dots {
  display: flex;
  gap: 10rpx;
}

.idle-outfit-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: rgba(196, 168, 130, 0.3);
}

.idle-outfit-dot.on {
  width: 32rpx;
  background: #c4a882;
}

.idle-outfit-card {
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.82),
    rgba(250, 244, 236, 0.88)
  );
  border: 1rpx solid rgba(196, 168, 130, 0.22);
  box-shadow: 0 8rpx 40rpx rgba(155, 132, 112, 0.12);
  animation: idleOutfitIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes idleOutfitIn {
  from {
    opacity: 0;
    transform: translateX(18rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.idle-outfit-title {
  font-size: 26rpx;
  color: #2e2821;
  margin-bottom: 20rpx;
}

.idle-piece {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(196, 168, 130, 0.12);
}

.idle-piece-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #ede5d8;
}

.idle-piece-body {
  flex: 1;
  min-width: 0;
}

.idle-piece-name {
  font-size: 24rpx;
  color: #2e2821;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.idle-piece-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #b5a090;
}

.idle-piece-tag {
  flex-shrink: 0;
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(224, 144, 154, 0.12);
  color: #b56070;
}

.idle-harmony {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.idle-harmony-label {
  font-size: 18rpx;
  color: #c4b5a0;
  flex-shrink: 0;
}

.idle-harmony-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(155, 132, 112, 0.1);
  overflow: hidden;
}

.idle-harmony-fill {
  height: 100%;
  border-radius: 999rpx;
}

.idle-harmony-score {
  font-size: 18rpx;
  flex-shrink: 0;
}

.idle-tip {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(245, 239, 230, 0.7);
  border: 1rpx solid rgba(196, 168, 130, 0.1);
  font-size: 20rpx;
  color: #7a6a58;
  line-height: 1.5;
}

.idle-match-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 12rpx;
}

.idle-save {
  flex: 1;
  text-align: center;
  padding: 22rpx 12rpx;
  border-radius: 24rpx;
  background: #2e2821;
  color: #faf8f4;
  font-size: 24rpx;
}

.idle-regen {
  flex: 1;
  text-align: center;
  padding: 22rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(196, 168, 130, 0.3);
  color: #7a5830;
  font-size: 24rpx;
}
