<view class="page">
  <view class="header section-pad">
    <view>
      <view class="eyebrow">我的衣橱</view>
      <view class="h1">{{total}} 件单品</view>
    </view>
    <view class="header-actions">
      <view class="icon-btn icon-btn-primary" bindtap="onAdd">＋</view>
    </view>
  </view>

  <view class="hint muted section-pad">{{hintText}}</view>

  <block wx:if="{{loggedIn}}">
  <scroll-view scroll-x class="cats section-pad" enhanced show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat {{activeCategory === item.id ? 'cat-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategory"
      >
        {{item.label}}
        <text class="count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && filtered.length === 0}}" class="empty section-pad">
    <view class="empty-title font-display">还没有衣物</view>
    <view class="empty-sub muted">拍一张衣服照片，填好品类就能入库。</view>
    <button class="empty-btn" bindtap="onAdd">添加第一件</button>
  </view>

  <view wx:elif="{{!loading}}" class="grid section-pad">
    <view
      wx:for="{{filtered}}"
      wx:key="id"
      class="item card"
      data-id="{{item.id}}"
      bindtap="onEdit"
    >
      <view class="thumb-wrap">
        <image
          wx:if="{{item.image}}"
          class="thumb"
          src="{{item.image}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="thumb tone-fallback" style="background: {{item.color}};"></view>
        <view class="dot" style="background: {{item.color}};"></view>
        <view class="flag flag-real">柜中</view>
      </view>
      <view class="meta">
        <view class="brand muted">{{item.brand}}</view>
        <view class="name">{{item.name}}</view>
        <view class="worn muted">已穿 {{item.worn}} 次</view>
      </view>
    </view>

    <view class="add card" bindtap="onAdd">
      <text class="cam">📷</text>
      <text class="add-text">添加单品</text>
    </view>
  </view>
  </block>

  <view wx:else class="empty section-pad">
    <view class="empty-title font-display">登录后查看衣橱</view>
    <view class="empty-sub muted">衣物按微信账号隔离，登录后同步云端数据。</view>
    <button class="empty-btn" loading="{{logging}}" bindtap="onLogin">微信授权登录</button>
  </view>
</view>
