{
  "pages": [
    "pages/splash/splash",
    "pages/recommend/recommend",
    "pages/wardrobe/wardrobe",
    "pages/weather/weather",
    "pages/profile/profile"
  ],
  "subpackages": [
    {
      "root": "package-closet",
      "name": "closet",
      "pages": [
        "add/add",
        "custom/custom"
      ]
    },
    {
      "root": "package-me",
      "name": "me",
      "pages": [
        "history/history",
        "care/care",
        "inspire/inspire",
        "pref/pref",
        "vip/vip",
        "settings/settings"
      ]
    }
  ],
  "preloadRule": {
    "pages/splash/splash": {
      "network": "all",
      "packages": ["closet"]
    },
    "pages/recommend/recommend": {
      "network": "all",
      "packages": ["closet"]
    },
    "pages/wardrobe/wardrobe": {
      "network": "all",
      "packages": ["closet"]
    },
    "pages/profile/profile": {
      "network": "all",
      "packages": ["me"]
    }
  },
  "window": {
    "navigationBarTitleText": "Dresia",
    "navigationBarBackgroundColor": "#F9F2E9",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F9F2E9",
    "backgroundTextStyle": "dark"
  },
  "cloud": true,
  "__usePrivacyCheck__": true,
  "permission": {
    "scope.userFuzzyLocation": {
      "desc": "用于获取你所在城市的天气与穿搭建议"
    }
  },
  "requiredPrivateInfos": [
    "getFuzzyLocation"
  ],
  "tabBar": {
    "custom": true,
    "color": "#8C7B75",
    "selectedColor": "#B5695A",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/recommend/recommend",
        "text": "首页"
      },
      {
        "pagePath": "pages/wardrobe/wardrobe",
        "text": "衣橱"
      },
      {
        "pagePath": "pages/weather/weather",
        "text": "天气"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
