<view class="tabbar {{hidden ? 'tabbar-hidden' : ''}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'on' : ''}}"
    data-index="{{index}}"
    bindtap="onSwitch"
  >
    <view class="icon-wrap {{selected === index ? 'icon-on' : ''}}">
      <image
        class="icon-img"
        src="{{selected === index ? item.iconActive : item.icon}}"
        mode="aspectFit"
      />
    </view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
