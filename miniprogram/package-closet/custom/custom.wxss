.studio {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.hero {
  padding-top: 12rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.2;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.mode-switch {
  display: flex;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  overflow: hidden;
}

.mode-btn {
  padding: 12rpx 18rpx;
  font-size: 20rpx;
  color: var(--muted-fg);
}

.mode-btn.on {
  background: var(--primary);
  color: #fff;
}

.title-input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  font-size: 26rpx;
}

.workspace {
  position: relative;
  margin-top: 8rpx;
  min-height: 720rpx;
}

.canvas {
  width: 100%;
  min-height: 720rpx;
  position: relative;
  padding: 16rpx 20rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(110, 80, 55, 0.1);
  overflow: hidden;
  box-sizing: border-box;
}

.sidebar-tab {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 12;
  width: 56rpx;
  padding: 28rpx 0;
  border-radius: 16rpx 0 0 16rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-right: none;
  box-shadow: -4rpx 4rpx 16rpx rgba(70, 45, 25, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.tab-label {
  writing-mode: vertical-rl;
  font-size: 22rpx;
  color: var(--fg);
  letter-spacing: 0.12em;
}

.tab-count {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
}

.sidebar-drawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 48%;
  max-width: 360rpx;
  min-width: 280rpx;
  z-index: 14;
  transform: translateX(110%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.sidebar-drawer.open {
  transform: translateX(0);
  pointer-events: auto;
}

.drawer-toggle {
  position: absolute;
  left: -40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 88rpx;
  border-radius: 16rpx 0 0 16rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-right: none;
  color: var(--muted-fg);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: -4rpx 4rpx 12rpx rgba(70, 45, 25, 0.08);
}

.canvas-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 20rpx;
  margin-bottom: 8rpx;
}

.canvas-empty {
  min-height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.canvas-empty-txt {
  font-size: 22rpx;
  color: var(--muted-fg);
}

.stage {
  position: relative;
  min-height: 620rpx;
  padding: 8rpx 8rpx 28rpx;
}

.stage-body {
  position: relative;
  width: 100%;
  min-height: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 32rpx;
}

.stage-slot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-tops,
.slot-coats {
  width: 240rpx;
  z-index: 3;
  margin-bottom: -32rpx;
}

.slot-coats {
  position: absolute;
  top: 8rpx;
  z-index: 4;
  width: 260rpx;
  opacity: 0.98;
}

.slot-bottoms {
  width: 250rpx;
  z-index: 2;
}

.stage-feet {
  width: 100%;
  margin-top: -12rpx;
  padding: 0 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  z-index: 5;
  box-sizing: border-box;
}

.slot-shoes {
  width: 112rpx;
}

.slot-acc {
  width: 112rpx;
}

.stage-img {
  width: 100%;
  height: 280rpx;
  border-radius: 18rpx;
  display: block;
  background: #fff;
}

.stage-img.sm {
  height: 132rpx;
}

.stage-fallback {
  opacity: 0.9;
}

.stage-x {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: rgba(120, 120, 120, 0.85);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 8;
}

.fab {
  position: absolute;
  z-index: 9;
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid rgba(28, 25, 23, 0.08);
  box-shadow: 0 6rpx 16rpx rgba(70, 45, 25, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.fab-ico {
  font-size: 18rpx;
  color: var(--primary);
  font-weight: 600;
}

.fab-txt {
  font-size: 16rpx;
  color: var(--muted-fg);
  transform: scale(0.92);
}

.fab-tops {
  right: 8rpx;
  top: 96rpx;
}

.fab-bottoms {
  right: 8rpx;
  top: 300rpx;
}

.fab-shoes {
  left: 8rpx;
  bottom: 48rpx;
}

.fab-acc {
  right: 8rpx;
  bottom: 48rpx;
}

.sidebar {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-left: 4rpx;
  box-sizing: border-box;
}

.panel {
  padding: 16rpx 14rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  box-shadow: 0 8rpx 20rpx rgba(70, 45, 25, 0.06);
}

.selected-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.sel-scroll {
  flex: 1;
  max-height: 360rpx;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.panel-title {
  font-size: 24rpx;
  font-weight: 600;
}

.panel-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
}

.count-pill {
  color: var(--muted-fg);
  font-size: 20rpx;
}

.clear-ico {
  font-size: 26rpx;
  line-height: 1;
}

.panel-empty {
  font-size: 20rpx;
  padding: 16rpx 0;
}

.sel-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(28, 25, 23, 0.05);
}

.sel-thumb {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--muted);
}

.sel-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sel-cat {
  align-self: flex-start;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(181, 105, 90, 0.12);
  color: var(--primary);
  font-size: 16rpx;
}

.sel-name {
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sel-remove {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #eee;
  color: #888;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-panel {
  flex-shrink: 0;
}

.tip-text {
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--fg);
  margin-bottom: 12rpx;
}

.tip-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tip-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--secondary);
  color: var(--primary);
  font-size: 18rpx;
}

/* 窄屏兜底：过窄时仍保持左右，压缩字号已在上方处理 */
@media (max-width: 360px) {
  .fab {
    width: 72rpx;
    height: 72rpx;
  }
  .fab-txt {
    display: none;
  }
}

.list-mode {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.list-slot {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid var(--border);
}

.list-slot-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.list-slot-label {
  font-size: 28rpx;
  font-weight: 600;
}

.list-selected {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.list-empty {
  font-size: 22rpx;
}

.cat-scroll {
  margin-top: 12rpx;
  white-space: nowrap;
}

.cat-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 40rpx 4rpx;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  font-size: 22rpx;
  color: var(--muted-fg);
}

.cat-chip.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.cat-count {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(181, 105, 90, 0.15);
  color: var(--primary);
  font-size: 18rpx;
  text-align: center;
  line-height: 28rpx;
}

.cat-chip.on .cat-count {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.bottom-tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.btab {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--muted-fg);
  background: transparent;
}

.btab.on {
  background: rgba(181, 105, 90, 0.12);
  color: var(--primary);
  font-weight: 600;
}

.picker-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 8rpx;
}

.picker-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 40rpx 24rpx;
}

.picker-empty {
  padding: 32rpx 8rpx;
  font-size: 22rpx;
}

.pick-card,
.rec-card {
  position: relative;
  width: 168rpx;
  flex-shrink: 0;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  white-space: normal;
}

.pick-card.in-use,
.rec-card.in-use {
  border-color: var(--primary);
  box-shadow: 0 0 0 2rpx rgba(181, 105, 90, 0.25);
}

.pick-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  z-index: 2;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 18rpx;
}

.pick-plus {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--primary);
  font-size: 28rpx;
  line-height: 34rpx;
  text-align: center;
  border: 1rpx solid rgba(181, 105, 90, 0.25);
}

.pick-img {
  width: 144rpx;
  height: 176rpx;
  border-radius: 14rpx;
  display: block;
  background: var(--muted);
}

.pick-name {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-card {
  width: 260rpx;
  padding: 20rpx;
}

.rec-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.rec-sub {
  font-size: 20rpx;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.rec-tag {
  font-size: 18rpx;
  color: var(--primary);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(250, 247, 244, 0.96);
  border-top: 1rpx solid var(--border);
}

.foot-btn {
  padding: 0 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  text-align: center;
}

.foot-btn.ghost {
  background: #fff;
  border: 1rpx solid var(--border);
  color: var(--fg);
}

.foot-done {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
