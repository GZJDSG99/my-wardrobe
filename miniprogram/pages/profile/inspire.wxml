<view class="page page-sub">
  <view class="week card">
    <view class="muted small">本周主题</view>
    <view class="week-name font-display">{{weekTheme}}</view>
    <button class="link-btn" bindtap="onSaveTheme">收藏到我想穿</button>
  </view>

  <view class="composer card">
    <view class="label">私密打卡</view>
    <textarea
      class="textarea"
      maxlength="80"
      placeholder="今天这套让你感觉如何？"
      value="{{text}}"
      bindinput="onInput"
    />
    <view class="moods">
      <view
        wx:for="{{moods}}"
        wx:key="id"
        class="mood {{item.on ? 'mood-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onMood"
      >{{item.id}}</view>
    </view>
    <button class="primary-btn block" bindtap="onSubmit">记下今天</button>
  </view>

  <view class="section-pad">
    <view class="block-title">最近打卡</view>
    <view wx:if="{{checkins.length === 0}}" class="muted">还没有打卡，写一句就开始。</view>
    <view wx:for="{{checkins}}" wx:key="id" class="checkin card">
      <view class="checkin-top">
        <text class="primary">{{item.mood}}</text>
        <text class="muted small">{{item.dateText}}</text>
      </view>
      <view class="checkin-text">{{item.text}}</view>
    </view>
  </view>

  <view class="section-pad" wx:if="{{favs.length}}">
    <view class="block-title">收藏</view>
    <view wx:for="{{favs}}" wx:key="id" class="fav muted">♡ {{item.title}}</view>
  </view>

  <view class="section-pad">
    <button class="ghost-btn" bindtap="onGoRecommend">用感觉生成今日款</button>
  </view>
</view>
