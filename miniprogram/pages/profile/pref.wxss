@import "./sub.wxss";

.profile-edit {
  margin: 24rpx 40rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  display: block;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--secondary);
  color: var(--primary);
  font-size: 22rpx;
}

.nick {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--secondary);
  border-radius: 16rpx;
  font-size: 28rpx;
}

.block-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--muted-fg);
  font-size: 24rpx;
}

.chip.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.footer {
  margin-top: 40rpx;
}

.block {
  width: 100%;
}
