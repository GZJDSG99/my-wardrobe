.header {
  padding-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.cats {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.cat-row {
  display: inline-flex;
  gap: 12rpx;
}

.cat {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--muted-fg);
  font-size: 24rpx;
  font-weight: 500;
}

.cat-on {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.count {
  margin-left: 8rpx;
  font-size: 20rpx;
  opacity: 0.7;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.item {
  overflow: hidden;
  border-radius: 32rpx;
}

.thumb-wrap {
  position: relative;
  height: 352rpx;
  background: var(--muted);
}

.thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.flag {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(28, 25, 23, 0.45);
  color: #fff;
  font-size: 18rpx;
}

.flag-real {
  background: rgba(181, 105, 90, 0.85);
}

.meta {
  padding: 20rpx;
}

.brand {
  font-size: 20rpx;
  margin-bottom: 4rpx;
}

.name {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
}

.worn {
  margin-top: 12rpx;
  font-size: 20rpx;
}

.add {
  min-height: 420rpx;
  border: 2rpx dashed rgba(28, 25, 23, 0.16);
  background: transparent;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--muted-fg);
  border-radius: 32rpx;
}

.cam {
  font-size: 40rpx;
}

.add-text {
  font-size: 22rpx;
  font-weight: 500;
}

.hint {
  margin: 16rpx 0 8rpx;
  font-size: 24rpx;
}

.empty {
  padding-top: 80rpx;
  text-align: center;
}

.empty-title {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-block;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
}

.tone-fallback {
  width: 100%;
  height: 100%;
}
