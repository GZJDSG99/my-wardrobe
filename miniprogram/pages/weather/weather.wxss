.hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding: 48rpx 40rpx;
  border-radius: 48rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #c9897a 0%, #8e6358 100%);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(142, 99, 88, 0.28);
}

.hero-deco {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 140rpx;
  opacity: 0.12;
  line-height: 1;
}

.hero-city,
.muted-light {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  font-weight: 500;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.locate-btn {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
}

.locate-busy {
  opacity: 0.7;
}

.actions {
  margin-top: 20rpx;
}

.city-label {
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.city-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.city-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--muted-fg);
  font-size: 24rpx;
}

.city-on {
  background: var(--primary-soft);
  border-color: rgba(181, 105, 90, 0.35);
  color: var(--primary);
}

.reset-btn {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--primary);
  font-size: 24rpx;
}

.hero-temp-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 12rpx;
}

.hero-temp {
  font-size: 140rpx;
  font-weight: 300;
  line-height: 1;
}

.hero-unit {
  font-size: 48rpx;
  opacity: 0.7;
  margin-bottom: 24rpx;
}

.hero-cond-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-icon {
  width: 56rpx;
  height: 56rpx;
}

.hero-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.hero-cond {
  font-size: 36rpx;
  font-weight: 600;
}

.forecast {
  overflow: hidden;
  border-radius: 32rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.row:last-child {
  border-bottom: none;
}

.day {
  width: 80rpx;
  font-size: 26rpx;
}

.cond {
  flex: 1;
  font-size: 22rpx;
}

.ico {
  margin-right: 20rpx;
  font-size: 28rpx;
}

.high {
  width: 64rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
}

.low {
  width: 56rpx;
  text-align: right;
  font-size: 22rpx;
}

.loading-tag {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.error-box {
  padding-top: 24rpx;
}

.error-text {
  display: block;
  color: #b5695a;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.retry {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  overflow: hidden;
  border-radius: 32rpx;
}

.detail-item {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
  border-right: 1rpx solid var(--border);
}

.detail-label {
  display: block;
  font-size: 20rpx;
  margin-bottom: 6rpx;
}

.detail-val {
  font-size: 26rpx;
  font-weight: 500;
}

.plan-note {
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.hero-metrics {
  display: flex;
  gap: 36rpx;
  margin-top: 32rpx;
}

.metric-label {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

.metric-val {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.block {
  margin-top: 36rpx;
}

.block-title {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.tip-card {
  margin-top: 28rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: var(--secondary);
  border-radius: 32rpx;
  border: 1rpx solid rgba(181, 105, 90, 0.15);
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.tip-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tip-pill {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 500;
}

.gen-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
